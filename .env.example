# Settings for the compose files. ./tunnel.sh install client|server writes .env
# for you (it asks for the values), using the defaults below. You can also copy
# this file to .env and edit it by hand.

# Which end this folder runs: client (inside machine) or server (outside
# server). ./tunnel.sh install sets it, so later commands know the role.
TUNNEL_ROLE=

# ---- Both ends
# SSH port of the outside server.
REVERSE_SERVER_SSH_PORT=22222
# Port on the outside server that leads back to the inside machine.
REVERSE_TUNNEL_SSH_PORT=22224
# Server: the user the inside machines log in as.
# Client: the user you log in as on the inside machine, through the tunnel.
USER_NAME=user

# ---- Inside machine (client) only
# Address of the outside server: a domain or an IP. Required.
REVERSE_SERVER_HOST=
# User name on the outside server (USER_NAME in the server's .env).
REVERSE_SERVER_USER_NAME=user
# sudo password inside the inside container. Empty: ./tunnel.sh makes a random one.
USER_PASSWORD=

# ---- Container
# The container user takes this uid/gid, so the files it writes stay yours.
# ./tunnel.sh puts your own id -u / id -g here (unless you run it as root).
PUID=1000
PGID=1000
TZ=Asia/Taipei
OPENSSH_IMAGE=lscr.io/linuxserver/openssh-server:latest
